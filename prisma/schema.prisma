// This is your Prisma schema file
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("employee") // "admin" | "employee"
  createdAt    DateTime   @default(now())
  // Horario laboral (America/Bogota) — L-J estándar, V sale antes
  workStart    String     @default("08:00")
  morningEnd   String     @default("13:00")
  lunchStart   String     @default("13:00")
  lunchEnd     String     @default("14:00")
  workEnd      String     @default("17:30") // L-J
  friWorkEnd   String     @default("17:00") // Viernes
  // Sábado especial (ej. María Angélica)
  satWorkStart String?
  satWorkEnd   String?
  // Descansos cortos opcionales (ventana flexible + duración fija)
  morningBreakStart   String?
  morningBreakEnd     String?
  afternoonBreakStart String?
  afternoonBreakEnd   String?
  restBreakMinutes    Int?
  autoAttendance Boolean    @default(false) // Registro automático sin botones manuales
  area         String?       // Área operativa (ej. "Enfermería", "Administración")
  reactions    Reaction[]
  comments     Comment[]
  shifts       Shift[]
  activityLogs ActivityLog[]
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  date      String   // "YYYY-MM-DD" (America/Bogota)
  area      String
  summary   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([date, area])
}

model Shift {
  id        String    @id @default(cuid())
  userId    String
  date      String    // "YYYY-MM-DD" for easy daily lookup
  checkIn   DateTime
  checkOut  DateTime?
  notes     String?
  ipAddress         String?
  userAgent         String?
  checkoutIpAddress String?
  checkoutUserAgent String?
  isLate            Boolean   @default(false)
  lateReason        String?
  lateReasonAt      DateTime?
  isEarly           Boolean   @default(false)
  earlyReason       String?
  earlyReasonAt     DateTime?
  autoCheckIn       Boolean   @default(false)
  autoCheckout      Boolean   @default(false)
  isLateCheckout    Boolean   @default(false)
  status            String    @default("active") // active | lunch_break | completed
  lunchStartedAt    DateTime?
  lunchEndedAt      DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model Post {
  id        String     @id @default(cuid())
  title     String
  body      String?  // Optional text content
  fileUrl   String?  // Optional file path
  type      String   @default("announcement") // "announcement" | "document"
  createdAt DateTime @default(now())
  reactions Reaction[]
  comments  Comment[]
}

model Reaction {
  id        String   @id @default(cuid())
  type      String   // "like" | "love" | "clap" | "idea" | "check"
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, type])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  postId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model LoginLog {
  id        String   @id @default(cuid())
  email     String
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
